# ./run.sh stack-init creates .env with independent random secrets.
# Keep .env private. Do not reuse cook-studio credentials or volumes.
FUNNEL_HOSTNAME=
CODING_API_KEY=
POCKET_ID_ENCRYPTION_KEY=
IMAGE_COOKIE_SECRET=
# Create a client in this repo's Pocket ID after private passkey enrollment.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Default: local loopback. Set one assigned RFC1918 IPv4 address for LAN access.
CODING_BIND=127.0.0.1
